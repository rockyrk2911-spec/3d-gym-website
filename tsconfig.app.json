{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,

    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "types": [
      "vite/client"
    ],

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },

  "include": [
    "src"
  ]
}